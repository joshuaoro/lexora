# Copy to .env before running the app.

# ── Database: Supabase Postgres ───────────────────────────────────────────
# Copy both strings from Supabase → Project Settings → Database → Connect.
#
# DATABASE_URL = "Transaction pooler" (port 6543). Used for all app queries.
#   Serverless functions open many short connections, so the pooler is required.
#   Keep the ?pgbouncer=true&connection_limit=1 suffix.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = "Session pooler" (port 5432). Used for migrations and scripts,
#   which cannot run through the transaction pooler. Prefer the session pooler
#   over the raw direct host — the latter is IPv6-only and often unreachable.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start in production without it. Generate with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=""

# Access code required to register a reading-specialist account. REQUIRED —
# specialist registration is disabled while this is unset. Choose a private
# value and share it only with your partner institution's specialists; anyone
# who knows it can see every learner's records and recordings.
SPECIALIST_CODE=""

# ── Speech recognition (oral reading assessment) ───────────────────────────
# Free key from https://console.groq.com — transcribes the learner's recorded
# reading with the pre-trained Whisper model. Without it LEXORA falls back to
# the browser's Web Speech recognizer (Chrome/Edge only).
GROQ_API_KEY=""

# Optional overrides
# ASR_MODEL="whisper-large-v3-turbo"
# ASR_BASE_URL="https://api.groq.com/openai/v1"

# Similarity (0.5–1.0) at or above which a reading counts as correct.
# Lower = more lenient. Tune against reading-specialist scoring.
# SCORE_THRESHOLD="0.95"

# ── Word audio ────────────────────────────────────────────────────────────
# Neural Filipino voice used by `npm run audio:generate`
# TTS_VOICE="fil-PH-BlessicaNeural"

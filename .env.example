# Copy to .env before running the app.

# SQLite database file (created by `npx prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# Session signing secret. REQUIRED — the app refuses to start in production
# without it. Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=""

# Access code required to register a reading-specialist account. REQUIRED —
# specialist registration is disabled while this is unset. Choose a private
# value and share it only with your partner institution's specialists; anyone
# who knows it can see every learner's records and recordings.
SPECIALIST_CODE=""

# ── Speech recognition (oral reading assessment) ───────────────────────────
# Free key from https://console.groq.com — transcribes the learner's recorded
# reading with the pre-trained Whisper model. Without it LEXORA falls back to
# the browser's Web Speech recognizer (Chrome/Edge only).
GROQ_API_KEY=""

# Optional overrides
# ASR_MODEL="whisper-large-v3-turbo"
# ASR_BASE_URL="https://api.groq.com/openai/v1"

# Similarity (0.5–1.0) at or above which a reading counts as correct.
# Lower = more lenient. Tune against reading-specialist scoring.
# SCORE_THRESHOLD="0.8"

# ── Word audio ────────────────────────────────────────────────────────────
# Neural Filipino voice used by `npm run audio:generate`
# TTS_VOICE="fil-PH-BlessicaNeural"
